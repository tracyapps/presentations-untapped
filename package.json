{
  "name": "presentations-untapped",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:audio": "node scripts/check-audio-policy.mjs",
    "test:blocks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-block-editability.mjs",
    "test:captions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-caption-timing.mjs",
    "test:image-geometry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-image-geometry.mjs",
    "test:media": "node scripts/check-media-policy.mjs",
    "test:media-references": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-media-references.mjs",
    "test:parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-render-parity.mjs",
    "test:styles": "node scripts/check-slide-styles.mjs",
    "test:variables": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-variables.mjs",
    "start": "next start",
    "db:backfill": "node --env-file=.env.local scripts/backfill-libraries.mjs",
    "db:backfill:apply": "node --env-file=.env.local scripts/backfill-libraries.mjs --apply",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.20.0",
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.44.0",
    "nanoid": "^5.0.9",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5"
  }
}
