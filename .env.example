# Neon — from neon.tech project dashboard (use the pooled connection string)
DATABASE_URL=

# Clerk — from clerk.com > your app > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Vercel Blob — auto-provided on Vercel; for local dev create a token in
# Vercel > Storage > Blob > .env.local tab
BLOB_READ_WRITE_TOKEN=
