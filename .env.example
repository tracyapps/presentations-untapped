# Neon — from neon.tech project dashboard (use the pooled connection string)
DATABASE_URL=

# Clerk — from clerk.com > your app > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Vercel Blob — shared by reusable images and per-slide voiceovers. A store
# named `media` may create media_READ_WRITE_TOKEN; the app accepts either.
BLOB_READ_WRITE_TOKEN=
media_READ_WRITE_TOKEN=
